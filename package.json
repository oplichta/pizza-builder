{
    "name": "pizza-builder",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build:deploy": "ng build --configuration production,deploy",
        "deploy": "ng deploy",
        "lint": "ng lint"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.2.18",
        "@angular/common": "^21.2.18",
        "@angular/compiler": "^21.2.18",
        "@angular/core": "^21.2.18",
        "@angular/fire": "^21.0.0-rc.0",
        "@angular/forms": "^21.2.18",
        "@angular/platform-browser": "^21.2.18",
        "@angular/platform-browser-dynamic": "^21.2.18",
        "@angular/router": "^21.2.18",
        "@jest/globals": "^29.7.0",
        "@ngrx/effects": "^21.1.1",
        "@ngrx/entity": "^21.1.1",
        "@ngrx/store": "^21.1.1",
        "@ngrx/store-devtools": "^21.1.1",
        "firebase": "^12.16.0",
        "mapbox-gl": "^3.26.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.2.19",
        "@angular/cli": "^21.2.19",
        "@angular/compiler-cli": "^21.2.18",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "angular-cli-ghpages": "^3.1.0",
        "angular-eslint": "21.4.0",
        "eslint": "^10.3.0",
        "firebase-tools": "^14.27.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jest-preset-angular": "^17.0.0",
        "prettier": "^3.4.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.59.2"
    },
    "prettier": {
        "printWidth": 140,
        "singleQuote": true,
        "semi": true,
        "arrowParens": "always",
        "trailingComma": "es5",
        "tabWidth": 4,
        "tabs": false,
        "endOfLine": "auto"
    },
    "jest": {
        "preset": "jest-preset-angular",
        "setupFilesAfterEnv": [
            "<rootDir>/setup-jest.ts"
        ],
        "testPathIgnorePatterns": [
            "<rootDir>/node_modules/",
            "<rootDir>/dist/"
        ]
    }
}
